# Frontend. Leave empty to use Vite's /api proxy.
VITE_API_URL=

# Backend
PORT=3001
APP_URL=http://localhost:5175
DATABASE_PATH=skillsetu.db
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:3000,http://127.0.0.1:4173,https://*.netlify.app,https://aindrop-075402.netlify.app,https://*.vercel.app,https://*.onrender.com

# NVIDIA AI Catalog Configuration (https://build.nvidia.com/)
# Register at https://build.nvidia.com to obtain an API key (starts with nvapi-)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional SMTP password-reset delivery. In local development without SMTP,
# the forgot-password screen displays a local-only reset link.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
